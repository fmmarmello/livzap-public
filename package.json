{
  "name": "@livzap/core",
  "version": "0.1.0",
  "description": "Production-grade WhatsApp gateway: deployable server and importable library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmmarmello/livzap.git"
  },
  "bugs": {
    "url": "https://github.com/fmmarmello/livzap/issues"
  },
  "homepage": "https://github.com/fmmarmello/livzap#readme",
  "keywords": [
    "whatsapp",
    "gateway",
    "webhook",
    "automation",
    "n8n",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "prepack": "npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "overrides": {
    "basic-ftp": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
