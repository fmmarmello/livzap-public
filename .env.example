# Server
# Copy this file to .env for local development. Never commit real .env files.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data

# WhatsApp (global defaults, per-instance overrides via API)
WHATSAPP_HEADLESS=true
WHATSAPP_PROTOCOL_TIMEOUT_MS=180000
WHATSAPP_AUTH_TIMEOUT_MS=120000
WHATSAPP_AUTO_RECONNECT=true

# Webhooks (where to send incoming messages)
WEBHOOK_URL=
WEBHOOK_EVENTS=message,message_create,disconnected,ready,qr
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=2

# API
API_KEY=replace-with-a-long-random-secret-min-24chars

# Security / Admin
SECURITY_MODE=strict
ADMIN_ENABLED=true
ADMIN_SESSION_TTL_MS=900000
SIGNED_URL_SECRET=
SIGNED_URL_TTL_SEC=120
ALLOWED_ORIGINS=
MAX_BODY_SIZE=1mb

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=30

# Media source controls
MEDIA_SOURCE_MODE=https_only
MEDIA_ALLOWED_DOMAINS=
MEDIA_LOCAL_BASE_DIR=./temp/uploads
MEDIA_MAX_DOWNLOAD_BYTES=15728640

# Anti-ban profile
ANTIBAN_PROFILE=conservative
ANTIBAN_MIN_DELAY_MS=1200
ANTIBAN_MAX_DELAY_MS=4000
ANTIBAN_TYPING_BY_DEFAULT=true
ANTIBAN_MAX_GLOBAL_PER_MINUTE=40
ANTIBAN_MAX_PER_CHAT_PER_MINUTE=12
ANTIBAN_FAILURE_THRESHOLD=3
ANTIBAN_COOLDOWN_MS=60000
ANTIBAN_MAX_QUEUE_SIZE=500
